{
  "_comment": [
    "The one definition of glass-lib's optical parameters and materials (design.md §11).",
    "tools/gen-params.py turns it into lib/glass-params-table.h at build time.",
    "params: key (glass_context_set_param), uniform (shaders/core/glass_params.glsl), default = the",
    "extension's gschema default, min/max = the extension's prefs.js slider range, px = a length in",
    "logical px (multiplied by the surface scale when drawn), values = the only allowed values if set.",
    "materials: in GlassMaterial order. Each sets only the keys it overrides (design §11.2: explicit",
    "context value, then the material's, then the default)."
  ],
  "params": [
    { "key": "max-z",                     "uniform": "max_z",                     "default": 25.0, "min": 0.0, "max": 100.0, "px": true,  "extension_key": "glass-max-z" },
    { "key": "displacement-scale",        "uniform": "displacement_scale",        "default": 78.5, "min": 0.0, "max": 200.0, "px": true,  "extension_key": "glass-displacement-scale" },
    { "key": "edge-smoothing",            "uniform": "edge_smoothing",            "default": 2.0,  "min": 0.0, "max": 10.0,  "px": true,  "extension_key": "glass-edge-smoothing" },
    { "key": "profile-shape-n",           "uniform": "profile_shape_n",           "default": 7.0,  "min": 1.0, "max": 20.0,  "px": false, "extension_key": "glass-profile-shape-n" },
    { "key": "ior",                       "uniform": "ior",                       "default": 2.4,  "min": 1.0, "max": 4.0,   "px": false, "extension_key": "glass-ior" },
    { "key": "chroma-strength",           "uniform": "chroma_strength",           "default": 1.5,  "min": 0.0, "max": 5.0,   "px": true,  "extension_key": "glass-chroma-strength" },
    { "key": "specular-intensity",        "uniform": "specular_intensity",        "default": 0.0,  "min": 0.0, "max": 5.0,   "px": false, "extension_key": "glass-specular-intensity" },
    { "key": "shininess",                 "uniform": "shininess",                 "default": 42.0, "min": 1.0, "max": 200.0, "px": false, "extension_key": "glass-shininess" },
    { "key": "rim-width",                 "uniform": "rim_width",                 "default": 5.0,  "min": 0.0, "max": 20.0,  "px": true,  "extension_key": "glass-rim-width" },
    { "key": "rim-intensity",             "uniform": "rim_intensity",             "default": 0.6,  "min": 0.0, "max": 5.0,   "px": false, "extension_key": "glass-rim-intensity" },
    { "key": "rim-directional-power",     "uniform": "rim_directional_power",     "default": 2.7,  "min": 0.0, "max": 10.0,  "px": false, "extension_key": "glass-rim-directional-power" },
    { "key": "rim-power",                 "uniform": "rim_power",                 "default": 6.0,  "min": 0.0, "max": 20.0,  "px": false, "extension_key": "glass-rim-power" },
    { "key": "rim-light-color-intensity", "uniform": "rim_light_color_intensity", "default": 1.4,  "min": 0.0, "max": 5.0,   "px": false, "extension_key": "glass-rim-light-color-intensity" },
    { "key": "sheen-intensity",           "uniform": "sheen_intensity",           "default": 0.32, "min": 0.0, "max": 2.0,   "px": false, "extension_key": "glass-sheen-intensity" },
    { "key": "light-angle-deg",           "uniform": "light_angle_deg",           "default": 50.0, "min": 0.0, "max": 360.0, "px": false, "extension_key": "glass-light-angle-deg" },
    { "key": "shadow-radius",             "uniform": "shadow_radius",             "default": 30.0, "min": 0.0, "max": 100.0, "px": true,  "extension_key": "shadow-radius" },
    { "key": "shadow-intensity",          "uniform": "shadow_intensity",          "default": 0.55, "min": 0.0, "max": 1.0,   "px": false, "extension_key": "shadow-intensity" },
    { "key": "ao-intensity",              "uniform": "ao_intensity",              "default": 0.25, "min": 0.0, "max": 1.0,   "px": false, "extension_key": "glass-ao-intensity" },
    { "key": "ao-radius",                 "uniform": "ao_radius",                 "default": 7.5,  "min": 0.0, "max": 50.0,  "px": true,  "extension_key": "glass-ao-radius" },
    { "key": "blur-radius",               "uniform": null,                        "default": 5.0,  "min": 0.0, "max": 30.0,  "px": true,  "extension_key": "dock-blur-radius" },
    { "key": "blur-downscale",            "uniform": null,                        "default": 2.0,  "min": 1.0, "max": 4.0,   "px": false, "extension_key": "glass-blur-downscale", "values": [1.0, 2.0, 4.0] }
  ],
  "edge_presets": {
